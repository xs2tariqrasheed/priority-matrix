# Postgres connection string (Supabase → Project Settings → Database → Connection string).
# Leave [YOUR-PASSWORD] as-is and put the password in DATABASE_PASSWORD, or paste the full URL.
#
# NOTE: the "direct" host (db.<ref>.supabase.co) is IPv6-only. If your network has no IPv6
# (most home connections), use the "Session pooler" string instead, which looks like:
#   postgresql://postgres.hqhvjfzpxrkomsgtgmcm:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.hqhvjfzpxrkomsgtgmcm.supabase.co:5432/postgres
DATABASE_PASSWORD=

# TLS: "disable" for a local Postgres; unset = TLS without CA verification (fine for Supabase).
# DATABASE_SSL=disable
# DATABASE_CA_CERT=./supabase-ca.crt   # optional: verify against Supabase's CA bundle

# PORT=4000
# SESSION_DAYS=30
# COOKIE_SECURE=true      # set when serving over HTTPS (implied by NODE_ENV=production)
# CLIENT_ORIGIN=https://app.example.com   # only if the client is served from another origin
# TRUST_PROXY=true        # behind a reverse proxy / load balancer
